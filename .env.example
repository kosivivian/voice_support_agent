# Copy to .env (never commit .env). Local dev reads this one root file.
# In production set the same variables on each Railway service / Vercel project
# (see README "Which service needs which variable").

# --- Claude (webhook server) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
AGENT_EFFORT=low
# Extended thinking adds 1.5-4 s before each spoken reply; leave off for voice.
AGENT_THINKING=off
# Pre-started agent processes kept ready (~250 MB each while idle). 2 covers a few concurrent calls.
AGENT_WARM_POOL=2
AGENT_SPARE_MAX_AGE_SECONDS=600
# Speak a short "one moment" if Jane has said nothing this long into a turn.
INSTANT_ACK_AFTER_MS=2500
SUMMARY_MODEL=claude-haiku-4-5

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role key: MCP server, admin API and setup scripts only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- MCP server ---
# On Railway, prefer the private network: http://<mcp-service>.railway.internal:<its PORT>
MCP_SERVER_URL=http://localhost:8788
# Shared secret between webhook server and MCP server. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=
# Caller verification: secret for hashing one-time codes (generate like MCP_API_KEY).
OTP_SECRET=
# Codes for test customers (addresses ending in .example can't receive mail) are sent here instead.
DEMO_OTP_INBOX=you@example.com

# --- Knowledge base embeddings (Voyage AI) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
# Minimum cosine similarity for a chunk to be used in an answer. Calibrate with: npm run kb:test
KB_SIMILARITY_THRESHOLD=0.5

# --- Vapi ---
VAPI_API_KEY=
# Optional shared secret Vapi sends with custom-LLM / server-URL requests (see docs/VAPI_SETUP.md)
VAPI_WEBHOOK_SECRET=

# --- Admin auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# onboarding@resend.dev only delivers to your own Resend account email until you verify a domain.
EMAIL_FROM=RelayPay Support <onboarding@resend.dev>
SUPPORT_EMAIL=support-team@example.com

# --- Webhook server ---
WEBHOOK_PORT=8787
# Origins allowed to call the public /api routes (comma-separated)
WEB_ORIGIN=http://localhost:3000

# --- Web app (Next.js) — put these in web/.env.local for local dev ---
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:8787
# Used only by the admin dashboard to receive Supabase Realtime change signals (no table access)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
WEBHOOK_URL=http://localhost:8787
